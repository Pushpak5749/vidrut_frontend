<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Admin Dashboard</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&amp;family=Hanken+Grotesk:wght@400;500&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                "colors": {
                    "primary-fixed-dim": "#00daf3",
                    "on-surface": "#dce4e5",
                    "surface-dim": "#0d1516",
                    "background": "#0d1516",
                    "on-primary": "#00363d",
                    "surface": "#0d1516",
                    "on-surface-variant": "#bac9cc",
                    "primary-fixed": "#9cf0ff",
                    "surface-variant": "#2e3638",
                    "surface-container": "#192122",
                    "outline-variant": "#3b494c",
                    "error": "#ffb4ab",
                    "success": "#9cf0ff" // reusing primary for success
                }
            }
        }
    }
</script>
<style>
    .glass-panel {
        background: rgba(13, 21, 22, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>
</head>
<body class="bg-background text-on-surface font-[Hanken_Grotesk]">

<header class="bg-surface/80 backdrop-blur-xl border-b border-outline-variant/30 px-8 py-4 sticky top-0 z-50 flex justify-between items-center">
    <div class="font-[Montserrat] text-2xl font-bold text-primary-fixed-dim">Admin Dashboard</div>
    <div class="flex gap-4">
        <span class="text-on-surface-variant">Logged in as <%= user.username %></span>
        <a href="/logout" class="text-primary-fixed-dim hover:underline">Logout</a>
    </div>
</header>

<main class="max-w-6xl mx-auto px-4 py-8">
    <% const urlParams = new URLSearchParams(typeof req !== 'undefined' ? req.query : {}); %>
    <% if (error) { %>
        <div class="mb-4 p-4 bg-red-900/50 border border-error text-error rounded"><%= error %></div>
    <% } %>
    <% if (success) { %>
        <div class="mb-4 p-4 bg-blue-900/50 border border-primary-fixed-dim text-primary-fixed-dim rounded"><%= success %></div>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- User Management -->
        <section class="glass-panel p-6 rounded-xl">
            <h2 class="text-2xl font-[Montserrat] text-primary-fixed-dim mb-4">User Management</h2>
            <form action="/admin/users/add" method="POST" class="mb-6 space-y-4">
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Username</label>
                    <input type="text" name="username" class="w-full bg-surface-container border border-outline-variant rounded p-2 text-on-surface" required>
                </div>
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Password</label>
                    <input type="password" name="password" class="w-full bg-surface-container border border-outline-variant rounded p-2 text-on-surface" required>
                </div>
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Role</label>
                    <select name="role" class="w-full bg-surface-container border border-outline-variant rounded p-2 text-on-surface" required>
                        <option value="user">User</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <button type="submit" class="w-full py-2 bg-primary-fixed-dim text-on-primary rounded font-bold hover:brightness-110 transition">Add User</button>
            </form>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="border-b border-outline-variant/50 text-on-surface-variant text-sm">
                            <th class="py-2">ID</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(u => { %>
                        <tr class="border-b border-outline-variant/20">
                            <td class="py-2"><%= u.id %></td>
                            <td><%= u.username %></td>
                            <td><%= u.role %></td>
                            <td>
                                <% if (u.id !== user.id) { %>
                                <form action="/admin/users/delete/<%= u.id %>" method="POST" class="inline">
                                    <button type="submit" class="text-error hover:underline text-sm">Delete</button>
                                </form>
                                <% } else { %>
                                <span class="text-on-surface-variant text-sm">Current</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Material Management -->
        <section class="glass-panel p-6 rounded-xl">
            <h2 class="text-2xl font-[Montserrat] text-primary-fixed-dim mb-4">Material Uploads</h2>
            <form action="/admin/materials/add" method="POST" enctype="multipart/form-data" class="mb-6 space-y-4">
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Course</label>
                    <select name="course_id" class="w-full bg-surface-container border border-outline-variant rounded p-2 text-on-surface" required>
                        <% courses.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Title</label>
                    <input type="text" name="title" class="w-full bg-surface-container border border-outline-variant rounded p-2 text-on-surface" required>
                </div>
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Type</label>
                    <select name="type" class="w-full bg-surface-container border border-outline-variant rounded p-2 text-on-surface" required>
                        <option value="document">Document</option>
                        <option value="video">Video</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">File</label>
                    <input type="file" name="file" class="w-full text-on-surface text-sm" required>
                </div>
                <button type="submit" class="w-full py-2 border border-primary-fixed-dim text-primary-fixed-dim rounded font-bold hover:bg-primary-fixed-dim hover:text-on-primary transition">Upload Material</button>
            </form>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-outline-variant/50 text-on-surface-variant">
                            <th class="py-2">Course</th>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% materials.forEach(m => { %>
                        <tr class="border-b border-outline-variant/20">
                            <td class="py-2"><%= m.course_name %></td>
                            <td><%= m.title %></td>
                            <td><%= m.type %></td>
                            <td>
                                <form action="/admin/materials/delete/<%= m.id %>" method="POST" class="inline">
                                    <button type="submit" class="text-error hover:underline">Remove</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Certificate Management -->
        <section class="glass-panel p-6 rounded-xl md:col-span-2">
            <h2 class="text-2xl font-[Montserrat] text-primary-fixed-dim mb-4">Certificate Management</h2>
            <form action="/admin/certificates/add" method="POST" enctype="multipart/form-data" class="mb-6 space-y-4 max-w-md">
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Select User</label>
                    <select name="user_id" class="w-full bg-surface-container border border-outline-variant rounded p-2 text-on-surface" required>
                        <% users.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.username %> (<%= u.role %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Certificate Title (e.g. Aerodynamics & Mechanics)</label>
                    <input type="text" name="title" class="w-full bg-surface-container border border-outline-variant rounded p-2 text-on-surface" required>
                </div>
                <div>
                    <label class="block text-sm text-on-surface-variant mb-1">Certificate File (PDF or Image)</label>
                    <input type="file" name="file" class="w-full text-on-surface text-sm" required>
                </div>
                <button type="submit" class="w-full py-2 border border-primary-fixed-dim text-primary-fixed-dim rounded font-bold hover:bg-primary-fixed-dim hover:text-on-primary transition">Upload Certificate</button>
            </form>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-outline-variant/50 text-on-surface-variant">
                            <th class="py-2">User</th>
                            <th>Title</th>
                            <th>File</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% certificates.forEach(cert => { %>
                        <tr class="border-b border-outline-variant/20">
                            <td class="py-2"><%= cert.username %></td>
                            <td><%= cert.title %></td>
                            <td><a href="<%= cert.file_path %>" target="_blank" class="text-primary-fixed-dim hover:underline">View File</a></td>
                            <td>
                                <form action="/admin/certificates/delete/<%= cert.id %>" method="POST" class="inline">
                                    <button type="submit" class="text-error hover:underline">Remove</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>

<script>
    // Extract query params for success/error messages without changing url directly
    const urlParams = new URLSearchParams(window.location.search);
    const error = urlParams.get('error');
    const success = urlParams.get('success');
    if(error || success) {
        // Clear params to prevent refresh resubmission of alerts
        window.history.replaceState({}, document.title, "/admin");
        if(error) alert('Error: ' + error);
        if(success) alert('Success: ' + success);
    }
</script>
</body>
</html>
