<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Vidrut Courses | Aerospace Catalog</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&amp;family=Hanken+Grotesk:wght@400;500&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "primary-fixed-dim": "#00daf3",
            "on-surface": "#dce4e5",
            "surface-dim": "#0d1516",
            "background": "#0d1516",
            "on-primary": "#00363d",
            "surface": "#0d1516",
            "on-surface-variant": "#bac9cc",
            "primary-fixed": "#9cf0ff",
            "surface-variant": "#2e3638",
            "surface-container": "#192122",
            "surface-container-highest": "#2e3638",
            "surface-container-lowest": "#080f11",
            "surface-container-high": "#242b2d",
            "surface-container-low": "#151d1e",
            "on-background": "#dce4e5",
            "outline-variant": "#3b494c",
            "outline": "#849396"
          },
          "fontFamily": {
            "label-sm": ["JetBrains Mono"],
            "body-md": ["Hanken Grotesk"],
            "headline-lg-mobile": ["Montserrat"],
            "headline-md": ["Montserrat"],
            "body-lg": ["Hanken Grotesk"],
            "display-lg": ["Montserrat"],
            "headline-lg": ["Montserrat"],
            "label-md": ["JetBrains Mono"]
          }
        },
      },
    }
  </script>
<style>
    body {
      background-color: #0d1516;
      color: #dce4e5;
    }
    .glass-card {
      background: rgba(25, 33, 34, 0.6);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      position: relative;
    }
    .glass-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 100%);
    }
    .glass-card:hover {
      backdrop-filter: blur(12px);
      box-shadow: 0px 0px 15px rgba(0, 218, 243, 0.2);
      transition: all 0.3s ease;
    }
    .glowing-btn {
      background: #00e5ff;
      color: #00363d;
      box-shadow: inset 0 0 10px rgba(255,255,255,0.4);
      transition: all 0.2s ease;
    }
    .glowing-btn:hover {
      filter: brightness(1.1);
      transform: translateY(-1px);
    }
    .telemetry-chip {
      border: 1px solid #3b494c;
      background: rgba(46, 54, 56, 0.4);
    }
    .search-input {
      background: transparent;
      border: none;
      border-bottom: 1px solid #3b494c;
      transition: all 0.3s ease;
    }
    .search-input:focus {
      border-bottom: 2px solid #00daf3;
      box-shadow: none;
      outline: none;
    }
  </style>
</head>
<body class="font-body-md text-body-md overflow-x-hidden">
<!-- TopAppBar Shell -->
<header class="bg-surface/80 backdrop-blur-xl docked w-full top-0 sticky z-50 border-b border-outline-variant/30 shadow-[0_0_20px_rgba(0,218,243,0.1)]">
<div class="flex justify-between items-center w-full px-8 py-4 max-w-[1280px] mx-auto">
<div class="font-headline-md text-2xl font-bold text-primary-fixed-dim tracking-tighter">Vidrut Courses</div>
<nav class="hidden md:flex items-center gap-8">
<a class="font-label-md text-sm text-on-surface-variant hover:text-on-surface transition-colors" href="/">Dashboard</a>
<a class="font-label-md text-sm text-on-surface-variant hover:text-on-surface transition-colors" href="/about.html">About Us</a>
<a class="font-label-md text-sm text-primary-fixed-dim border-b-2 border-primary-fixed-dim pb-1" href="/catalog">Courses</a>
<a class="font-label-md text-sm text-on-surface-variant hover:text-on-surface transition-colors" href="/verify.html">Certificates</a>
</nav>
<div class="flex items-center gap-4">
<% if (user) { %>
    <a href="/logout" class="font-label-md text-sm px-4 py-2 bg-surface-variant text-on-surface rounded hover:brightness-110 transition-all">Logout (<%= user.username %>)</a>
<% } else { %>
    <a href="/login" class="font-label-md text-sm text-on-surface px-4 py-2 hover:bg-white/5 transition-all">Login</a>
<% } %>
</div>
</div>
</header>

<main class="max-w-[1280px] mx-auto px-8 pt-16 pb-24">
<!-- Hero / Title Section -->
<section class="mb-16">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
<div>
<span class="font-label-sm text-xs text-primary-fixed-dim uppercase tracking-widest mb-4 block">Fleet Training Modules</span>
<h1 class="font-display-lg text-4xl font-bold text-on-surface mb-4">Course Catalog</h1>
<p class="font-body-lg text-lg text-on-surface-variant max-w-2xl">Master the mechanics of the cosmos. Access advanced curriculum in aerospace engineering.</p>
</div>
</div>
</section>

<!-- Bento/Grid Content -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
<% courses.forEach(course => { %>
    <div class="glass-card p-6 flex flex-col h-full rounded-xl">
        <h3 class="font-headline-md text-2xl font-bold text-on-surface mb-4"><%= course.name %></h3>
        <p class="font-body-md text-on-surface-variant mb-6 flex-grow">Access specialized materials, documents, and videos curated by the administration for <%= course.name %>.</p>
        <a href="/course/<%= course.id %>" class="glowing-btn text-center block w-full py-3 rounded-lg font-label-md text-sm font-bold uppercase tracking-widest">
            Enter Course Area
        </a>
    </div>
<% }) %>
</div>

</main>
<!-- Footer Shell -->
<footer class="bg-surface-container-lowest border-t border-outline-variant/20 mt-auto">
<div class="flex flex-col md:flex-row justify-between items-center w-full px-8 py-8 max-w-[1280px] mx-auto gap-4">
<div class="flex flex-col gap-2">
<div class="font-label-md text-sm font-bold text-on-surface">Vidrut Drones</div>
<div class="font-label-sm text-xs text-on-surface-variant">© 2025 Vidrut Drones. All rights reserved.</div>
</div>
<div class="flex gap-4">
<span class="material-symbols-outlined text-outline hover:text-primary-fixed-dim cursor-pointer">language</span>
<span class="material-symbols-outlined text-outline hover:text-primary-fixed-dim cursor-pointer">shield</span>
</div>
</div>
</footer>
</body></html>
